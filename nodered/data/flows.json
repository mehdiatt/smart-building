    {
        "id": "95bed4e6b400da60",
        "type": "function",
        "z": "2d53dca1b77302fd",
        "name": "Prepare Invalid Message",
        "func": "\nconst data = msg.payload;\n\n// Preserve the original message and add rejection metadata\nconst invalidMessage = (data && typeof data === \"object\" && !Array.isArray(data))\n    ? { ...data }\n    : { originalPayload: data };\n\ninvalidMessage.error = msg.validationError || \"Invalid message\";\ninvalidMessage.receivedAt = new Date().toISOString();\n\nmsg.payload = invalidMessage;\n\nreturn msg;\n",
