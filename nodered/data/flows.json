    {
        "id": "45998e0a82d7153f",
        "type": "function",
        "z": "2d53dca1b77302fd",
        "name": "Validate Data",
        "func": "\nconst data = msg.payload;\n\n// Check required fields from the original MQTT message\nif (\n    !data ||\n    typeof data !== \"object\" ||\n    Array.isArray(data) ||\n    !data.sensorId ||\n    !data.sensorType ||\n    !data.topic ||\n    data.value === undefined ||\n    !data.unit ||\n    !data.timestamp\n) {\n    msg.validationError = \"Missing required fields\";\n    return [null, msg];\n}\n\n// Check sensor value\nif (typeof data.value !== \"number\" || !Number.isFinite(data.value)) {\n    msg.validationError = \"Invalid sensor value\";\n    return [null, msg];\n}\n\n// Check timestamp\nif (isNaN(Date.parse(data.timestamp))) {\n    msg.validationError = \"Invalid timestamp\";\n    return [null, msg];\n}\n\n// Valid message\nmsg.valid = true;\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 320,
        "wires": [
            [
                "a6f0a4f9a9e275d8"
            ],
            [
                "95bed4e6b400da60"
            ]
        ]
    },
    {
        "id": "a6f0a4f9a9e275d8",
        "type": "function",
        "z": "2d53dca1b77302fd",
        "name": "Enrich Data",
        "func": "\nconst data = msg.payload;\n\nif (!data || typeof data !== \"object\") {\n    node.error(\"Invalid payload in Enrich Data\", msg);\n    return null;\n}\n// Validate required sensor fields\nconst allowedTypes = [\n    \"temperature\",\n    \"humidity\",\n    \"co2\",\n    \"occupancy\",\n    \"energy\"\n];\n\nif (\n    typeof data.sensorId !== \"string\" ||\n    !data.sensorId.trim() ||\n    !allowedTypes.includes(data.sensorType) ||\n    data.value === undefined ||\n    data.value === null ||\n    data.value === \"\" ||\n    !Number.isFinite(Number(data.value)) ||\n    typeof data.unit !== \"string\" ||\n    !data.unit.trim()\n) {\n    node.error(\"Invalid sensor data: missing or incorrect required fields\", msg);\n    return null;\n}\n// Extract MQTT topic\nconst topic = data.topic || msg.topic;\nif (!topic || typeof topic !== \"string\") {\n    node.error(\"Missing MQTT topic\", msg);\n    return null;\n}\n\nconst parts = topic.split(\"/\");\n\nif (parts.length !== 5 || parts[0] !== \"building\") {\n    node.error(\"Invalid MQTT topic: \" + topic, msg);\n    return null;\n}\n\n// Generate UUID\nfunction uuid() {\n    return \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, c => {\n        const r = Math.random() * 16 | 0;\n        return (c === \"x\" ? r : (r & 0x3 | 0x8)).toString(16);\n    });\n}\n\nconst now = new Date().toISOString();\n\n// Extract location\ndata.buildingId = parts[1];\ndata.floor = Number(parts[2]);\ndata.room = parts[3];\n\n// Zone\ndata.zone = \"bureaux\";\n\n// Contract fields\ndata.schemaVersion = 1;\ndata.messageId = uuid();\ndata.processedAt = now;\n\n// Determine status\nconst type = data.sensorType;\nconst value = Number(data.value);\n\nlet status = \"ok\";\n\nswitch (type) {\n    case \"temperature\":\n        if (value > 28 || value < 16) status = \"critical\";\n        else if (value > 26 || value < 18) status = \"warning\";\n        break;\n\n    case \"humidity\":\n        if (value > 75 || value < 20) status = \"critical\";\n        else if (value > 65 || value < 25) status = \"warning\";\n        break;\n\n    case \"co2\":\n        if (value > 1500) status = \"critical\";\n        else if (value > 1000) status = \"warning\";\n        break;\n\n    case \"energy\":\n        if (value > 5) status = \"critical\";\n        else if (value > 3) status = \"warning\";\n        break;\n}\n\ndata.status = status;\n\n// Kafka message key\nmsg.key = data.room;\n\n// Send enriched message\nmsg.payload = data;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
