# Copy this file to .env (cp .env.example .env), then change the passwords.
# The .env file must NEVER be committed.

# Ports exposed on the host machine
MQTT_PORT=1883
NODERED_PORT=1880
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
INFLUX_PORT=8086
GRAFANA_PORT=3000

# InfluxDB
INFLUX_USER=admin
INFLUX_PASSWORD=changeme123
INFLUX_TOKEN=change-me-super-secret-token

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# MQTT (used from day 8, once anonymous access is disabled)
MQTT_SIMULATOR_USER=simulator
MQTT_SIMULATOR_PASSWORD=changeme
MQTT_NODERED_USER=nodered
MQTT_NODERED_PASSWORD=changeme

# Telegram notifications (day 8) — leave empty to run the notifier in DRY-RUN mode
# Token: from @BotFather. Chat id: docker compose run --rm notifier python notifier.py --find-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
