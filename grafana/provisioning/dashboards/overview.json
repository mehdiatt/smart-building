    {
      "id": 12,
      "type": "timeseries",
      "title": "Pipeline latency (sensor → InfluxDB)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "description": "ingest = sensor → Node-RED · pipeline = Node-RED → Kafka → consumer → InfluxDB · total = end to end. Measured by storage-consumer every 10 s.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"building\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pipeline_latency\")\n  |> filter(fn: (r) => r._field == \"avg_total_ms\" or r._field == \"p95_total_ms\" or r._field == \"avg_ingest_ms\" or r._field == \"avg_pipeline_ms\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95_total_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95 total"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_total_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "avg total"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_ingest_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "avg ingest (sensor → Node-RED)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_pipeline_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "avg pipeline (Node-RED → InfluxDB)"
              },
              {
                "id": "color",
