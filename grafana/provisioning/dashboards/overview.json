        "name": "Critical alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"building\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alerts\" and r._field == \"message\" and r.severity == \"critical\")\n  |> filter(fn: (r) => \"${floor}\" == \"All\" or r.floor == \"${floor}\")\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, text: r.room + \" · \" + r.sensorType + \" · \" + r._value}))"
        },
